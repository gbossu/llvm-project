# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=aarch64 -enable-subreg-liveness \
# RUN:   -passes='require<live-intervals>,two-address-instruction,verify' \
# RUN:   %s -o - | FileCheck %s

# The REG_SEQUENCE defines only sub_32, while FAKE_USE reads %0 in full, so
# TwoAddressInstruction sees uncovered upper lanes checks if subregister uses
# of %0 need to be marked as undef after the REG_SEQUENCE is eliminated.

# getInstructionIndex() has a fragile behaviour for debug instructions: it tries
# its best to skip them and find following non-debug instruction. With two
# consecutive DBG_VALUEs, that fails.
# TwoAddressInstruction should skip debug uses altogether.

--- |
  target triple = "aarch64"

  define void @reg_sequence_debug_subreg() !dbg !4 {
    ret void
  }

  declare void @llvm.dbg.value(metadata, metadata, metadata)

  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!3}
  !0 = distinct !DICompileUnit(language: DW_LANG_C99, file: !1,
    producer: "clang", isOptimized: true, runtimeVersion: 0,
    emissionKind: FullDebug)
  !1 = !DIFile(filename: "reproducer.c", directory: "")
  !2 = !{}
  !3 = !{i32 1, !"Debug Info Version", i32 3}
  !4 = distinct !DISubprogram(name: "reg_sequence_debug_subreg", scope: !1,
    file: !1, line: 1, type: !5, scopeLine: 1, unit: !0)
  !5 = !DISubroutineType(types: !2)
  !6 = !DILocalVariable(name: "x", scope: !4, file: !1, line: 1, type: !7)
  !7 = !DIBasicType(name: "int", size: 32, encoding: DW_ATE_signed)
  !8 = !DILocation(line: 1, column: 1, scope: !4)
  !9 = !DILocalVariable(name: "y", scope: !4, file: !1, line: 1, type: !7)
...
---
name:            reg_sequence_debug_subreg
isSSA:           true
tracksRegLiveness: true
body:             |
  bb.0:
    ; CHECK-LABEL: name: reg_sequence_debug_subreg
    ; CHECK: undef [[COPY:%[0-9]+]].sub_32:gpr64 = COPY $wzr
    ; CHECK-NEXT: FAKE_USE [[COPY]]
    ; CHECK-NEXT: DBG_VALUE [[COPY]].sub_32, $noreg, !6, !DIExpression(DW_OP_LLVM_convert, 32, DW_ATE_unsigned, DW_OP_LLVM_convert, 64, DW_ATE_unsigned, DW_OP_stack_value), debug-location !DILocation(line: 1, column: 1, scope: !3)
    ; CHECK-NEXT: DBG_VALUE [[COPY]].sub_32, $noreg, !8, !DIExpression(DW_OP_LLVM_convert, 32, DW_ATE_unsigned, DW_OP_LLVM_convert, 64, DW_ATE_unsigned, DW_OP_stack_value), debug-location !DILocation(line: 1, column: 1, scope: !3)
    ; CHECK-NEXT: RET_ReallyLR
    %0:gpr64 = REG_SEQUENCE $wzr, %subreg.sub_32
    FAKE_USE %0
    DBG_VALUE %0.sub_32, $noreg, !6, !DIExpression(DW_OP_LLVM_convert, 32, DW_ATE_unsigned, DW_OP_LLVM_convert, 64, DW_ATE_unsigned, DW_OP_stack_value), debug-location !8
    DBG_VALUE %0.sub_32, $noreg, !9, !DIExpression(DW_OP_LLVM_convert, 32, DW_ATE_unsigned, DW_OP_LLVM_convert, 64, DW_ATE_unsigned, DW_OP_stack_value), debug-location !8
    RET_ReallyLR
...
