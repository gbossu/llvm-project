# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=aarch64 -enable-subreg-liveness \
# RUN:   -passes='greedy,verify' %s -o - | FileCheck %s


# %0 is spilled due to the interference with %2 (also restricted to x17) and the
# call clobbers. When it gets reloaded and folded into the dead %1 copy, make
# the dead flag is preserved, because its live interval expects it.
# Such dead COPY instructions can be left by the coalescer and are not cleaned
# up by a subsequent dead-mi pass.

---
name:            test
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: test
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $x0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   STRXui $x0, %stack.0, 0 :: (store (s64) into %stack.0)
  ; CHECK-NEXT:   B %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[DEF:%[0-9]+]]:tcgprx17 = IMPLICIT_DEF
  ; CHECK-NEXT:   dead [[LDRXui:%[0-9]+]]:gpr64 = LDRXui %stack.0, 0 :: (load (s64) from %stack.0)
  ; CHECK-NEXT:   $x1 = COPY [[DEF]]
  ; CHECK-NEXT:   BL 0, csr_aarch64_aapcs, implicit-def dead $lr, implicit $sp, implicit-def $sp
  ; CHECK-NEXT:   B %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   $x0 = LDRXui %stack.0, 0 :: (load (s64) from %stack.0)
  ; CHECK-NEXT:   RET_ReallyLR implicit $x0
  bb.0:
    liveins: $x0
    successors: %bb.1

    %0:tcgprx17 = COPY $x0
    B %bb.1

  bb.1:
    successors: %bb.2

    %2:tcgprx17 = IMPLICIT_DEF
    dead %1:gpr64all = COPY %0
    $x1 = COPY %2
    BL 0, csr_aarch64_aapcs, implicit-def dead $lr, implicit $sp, implicit-def $sp
    B %bb.2

  bb.2:
    $x0 = COPY %0
    RET_ReallyLR implicit $x0
...
