# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=aarch64 -mattr=+sve2p1 \
# RUN:   -passes='aarch64-expand-pseudo,verify' %s -o - | FileCheck %s

# A ZZ tuple might have some of its members undefined. Ensure we do not generate
# a STR_ZXI for those, as that would read an undefined register.

---
name: expand_partial_z_tuple_store_second
tracksRegLiveness: true
noVRegs: true
body: |
  bb.0:
    ; CHECK-LABEL: name: expand_partial_z_tuple_store
    ; CHECK: $z1 = IMPLICIT_DEF
    ; CHECK-NEXT: $x0 = IMPLICIT_DEF
    ; CHECK-NEXT: STR_ZXI $z1, killed $x0, 1
    ; CHECK-NEXT: RET undef $lr
    $z1 = IMPLICIT_DEF
    $x0 = IMPLICIT_DEF
    STR_ZZXI $z0_z1, killed $x0, 0
    RET undef $lr
...
---
name: expand_partial_z_tuple_store_first
tracksRegLiveness: true
noVRegs: true
body: |
  bb.0:
    ; CHECK-LABEL: name: expand_partial_z_tuple_store_first
    ; CHECK: $z0 = IMPLICIT_DEF
    ; CHECK-NEXT: $x0 = IMPLICIT_DEF
    ; CHECK-NEXT: STR_ZXI $z0, killed $x0, 0
    ; CHECK-NEXT: RET undef $lr
    $z0 = IMPLICIT_DEF
    $x0 = IMPLICIT_DEF
    STR_ZZXI $z0_z1, killed $x0, 0
    RET undef $lr
...
