# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=aarch64 -enable-subreg-liveness -verify-machineinstrs \
# RUN:   -passes='greedy,virt-reg-rewriter' %s -o - | FileCheck %s

# FMOVS0 defines the addressable S subregister while leaving the rest of Q0
# undefined in the virtual register. Q0 is used in full after the merge, so
# VirtRegRewriter needs to add physical defs for the upper 96 bits on the bb.1
# edge.

---
name: qq_unrepresentable_undef_lanes
isSSA: false
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: qq_unrepresentable_undef_lanes
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   CBNZW $wzr, %bb.2
  ; CHECK-NEXT:   B %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $s0 = FMOVS0 implicit-def $s0_hi, implicit-def $d0_hi, implicit-def renamable $q0
  ; CHECK-NEXT:   B %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $q0 = MOVIv2d_ns 1
  ; CHECK-NEXT:   B %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   liveins: $q0_q1:0x000000000000002F
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   STRQui killed renamable $q0, $sp, 0 :: (store (s128))
  ; CHECK-NEXT:   RET_ReallyLR
  bb.0:
    successors: %bb.1, %bb.2

    CBNZW $wzr, %bb.2
    B %bb.1

  bb.1:
    successors: %bb.3

    undef %0.ssub:qq = FMOVS0
    B %bb.3

  bb.2:
    successors: %bb.3

    undef %0.qsub0:qq = MOVIv2d_ns 1
    B %bb.3

  bb.3:
    STRQui %0.qsub0, $sp, 0 :: (store (s128))
    RET_ReallyLR
...
