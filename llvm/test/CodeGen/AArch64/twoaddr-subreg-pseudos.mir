# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=aarch64 -enable-subreg-liveness=true --passes='require<live-intervals>,two-address-instruction' -verify-each -o - %s | FileCheck %s

# TwoAddressInstructionPass may insert a new IMPLICIT_DEF instruction to ensure all lanes
# have a definition point. This happens in e.g. coalescer-empty-subrange-early-lis.ll
---
name: insert_subreg_whole_use
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $w1

    ; CHECK-LABEL: name: insert_subreg_whole_use
    ; CHECK: liveins: $w1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr32 = COPY $w1
    ; CHECK-NEXT: [[DEF:%[0-9]+]]:gpr64 = IMPLICIT_DEF
    ; CHECK-NEXT: [[DEF:%[0-9]+]].sub_32:gpr64 = COPY [[COPY]]
    ; CHECK-NEXT: STRXui [[DEF]], $sp, 0
    ; CHECK-NEXT: FAKE_USE [[DEF]].sub_32
    ; CHECK-NEXT: RET_ReallyLR
    %0:gpr32 = COPY $w1
    %1:gpr64 = INSERT_SUBREG undef %2:gpr64, %0, %subreg.sub_32
    STRXui %1, $sp, 0
    FAKE_USE %1.sub_32
    RET_ReallyLR
...

---
name: insert_subreg_tuple_whole_use
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x0, $x1

    ; CHECK-LABEL: name: insert_subreg_tuple_whole_use
    ; CHECK: liveins: $x0, $x1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[LDRQui:%[0-9]+]]:fpr128 = LDRQui $x1, 0
    ; CHECK-NEXT: [[DEF:%[0-9]+]]:qqq = IMPLICIT_DEF
    ; CHECK-NEXT: [[DEF:%[0-9]+]].qsub0:qqq = COPY [[LDRQui]]
    ; CHECK-NEXT: ST3Threev16b [[DEF]], $x0
    ; CHECK-NEXT: FAKE_USE [[DEF]].qsub0
    ; CHECK-NEXT: RET_ReallyLR
    %0:fpr128 = LDRQui $x1, 0
    %1:qqq = INSERT_SUBREG undef %2:qqq, %0, %subreg.qsub0
    ST3Threev16b %1, $x0
    FAKE_USE %1.qsub0
    RET_ReallyLR
...

# note SUBREG_TO_REG is untouched by TwoAddressInstructionPass.
---
name: subreg_to_reg_whole_use
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $w1

    ; CHECK-LABEL: name: subreg_to_reg_whole_use
    ; CHECK: liveins: $w1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr32 = COPY $w1
    ; CHECK-NEXT: [[SUBREG_TO_REG:%[0-9]+]]:gpr64 = SUBREG_TO_REG [[COPY]], %subreg.sub_32
    ; CHECK-NEXT: STRXui [[SUBREG_TO_REG]], $sp, 0
    ; CHECK-NEXT: RET_ReallyLR
    %0:gpr32 = COPY $w1
    %1:gpr64 = SUBREG_TO_REG %0, %subreg.sub_32
    STRXui %1, $sp, 0
    RET_ReallyLR
...

---
name: reg_sequence_partial_tuple
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x0, $x1, $x2, $x3

    ; CHECK-LABEL: name: reg_sequence_partial_tuple
    ; CHECK: liveins: $x0, $x1, $x2, $x3
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[LDRQui:%[0-9]+]]:fpr128 = LDRQui $x1, 0
    ; CHECK-NEXT: [[LDRDui:%[0-9]+]]:fpr64 = LDRDui $x2, 0
    ; CHECK-NEXT: [[LDRQui1:%[0-9]+]]:fpr128 = LDRQui $x3, 0
    ; CHECK-NEXT: undef [[COPY:%[0-9]+]].qsub0:qqq = COPY [[LDRQui]]
    ; CHECK-NEXT: [[COPY:%[0-9]+]].dsub1:qqq = COPY [[LDRDui]]
    ; CHECK-NEXT: [[COPY:%[0-9]+]].qsub2:qqq = COPY [[LDRQui1]]
    ; CHECK-NEXT: ST3Threev16b [[COPY]], $x0
    ; CHECK-NEXT: FAKE_USE [[COPY]].qsub0
    ; CHECK-NEXT: FAKE_USE [[COPY]].dsub1
    ; CHECK-NEXT: RET_ReallyLR
    %0:fpr128 = LDRQui $x1, 0
    %1:fpr64 = LDRDui $x2, 0
    %2:fpr128 = LDRQui $x3, 0
    %3:qqq = REG_SEQUENCE %0, %subreg.qsub0, %1, %subreg.dsub1, %2, %subreg.qsub2
    ST3Threev16b %3, $x0
    FAKE_USE %3.qsub0
    FAKE_USE %3.dsub1
    RET_ReallyLR
...
