# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=aarch64 --run-pass=liveintervals,aarch64-mi-peephole-opt \
# RUN:   -verify-machineinstrs -enable-subreg-liveness -o - %s | FileCheck %s

# Similar to peephole-movimm-insert-subreg.mir but for REG_SEQUENCE
---
name: add
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x0
    ; CHECK-LABEL: name: add
    ; CHECK: liveins: $x0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %src:gpr64common = COPY $x0
    ; CHECK-NEXT: [[ADDXri:%[0-9]+]]:gpr64sp = ADDXri %src, 273, 12
    ; CHECK-NEXT: [[ADDXri1:%[0-9]+]]:gpr64common = ADDXri [[ADDXri]], 3549, 0
    ; CHECK-NEXT: $x0 = COPY [[ADDXri1]]
    ; CHECK-NEXT: RET_ReallyLR implicit $x0
    %src:gpr64 = COPY $x0
    %imm:gpr32 = MOVi32imm 1121757
    %wide:gpr64 = REG_SEQUENCE %imm, %subreg.sub_32
    %result:gpr64common = ADDXrr %src, %wide
    $x0 = COPY %result
    RET_ReallyLR implicit $x0
...

# -2095105 is 0xffe007ff as a 32-bit value. The upper 32 bits must be zero.
---
name: negative_imm
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x0
    ; CHECK-LABEL: name: negative_imm
    ; CHECK: liveins: $x0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %src:gpr64 = COPY $x0
    ; CHECK-NEXT: [[ANDXri:%[0-9]+]]:gpr64common = ANDXri %src, 4127
    ; CHECK-NEXT: [[ANDXri1:%[0-9]+]]:gpr64common = ANDXri [[ANDXri]], 6901
    ; CHECK-NEXT: $x0 = COPY [[ANDXri1]]
    ; CHECK-NEXT: RET_ReallyLR implicit $x0
    %src:gpr64 = COPY $x0
    %imm:gpr32 = MOVi32imm -2095105
    %wide:gpr64 = REG_SEQUENCE %imm, %subreg.sub_32
    %result:gpr64common = ANDXrr %src, %wide
    $x0 = COPY %result
    RET_ReallyLR implicit $x0
...
