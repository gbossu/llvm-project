# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=aarch64 -enable-subreg-liveness \
# RUN:   -passes='require<live-intervals>,two-address-instruction,verify' \
# RUN:   %s -o - | FileCheck %s

# TwoAddressInstruction expands the REG_SEQUENCE by inserting an undef
# subregister COPY before it, then erases the REG_SEQUENCE.
# Run the MachineVerifier afterwards to ensure the LI for %0 is correctly updated,
# especially the sub_32_hi lanes which should not appear as live or have the
# now-removed REG_SEQUENCE as their defining instruction.

---
name:            reg_sequence_subreg_vninfo
isSSA:           true
tracksRegLiveness: true
body:             |
  bb.0:
    ; CHECK-LABEL: name: reg_sequence_subreg_vninfo
    ; CHECK: undef [[COPY:%[0-9]+]].sub_32:gpr64 = COPY $wzr
    ; CHECK-NEXT: FAKE_USE [[COPY]].sub_32
    ; CHECK-NEXT: FAKE_USE [[COPY]]
    ; CHECK-NEXT: RET_ReallyLR
    %0:gpr64 = REG_SEQUENCE $wzr, %subreg.sub_32
    FAKE_USE %0.sub_32
    FAKE_USE %0
    RET_ReallyLR
...
