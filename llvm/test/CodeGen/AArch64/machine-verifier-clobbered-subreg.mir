# RUN: split-file %s %t
# RUN: not --crash llc -mtriple=aarch64 -run-pass=liveintervals -verify-machineinstrs -enable-subreg-liveness=true -o /dev/null %t/invalid-gpr.mir 2>&1 | FileCheck %s --check-prefix=GPR
# RUN: not --crash llc -mtriple=aarch64 -run-pass=liveintervals -verify-machineinstrs -enable-subreg-liveness=true -o /dev/null %t/invalid-qqq.mir 2>&1 | FileCheck %s --check-prefix=QQQ
# RUN: llc -mtriple=aarch64 -run-pass=liveintervals -verify-machineinstrs -enable-subreg-liveness=true -o /dev/null %t/valid.mir
# RUN: llc -mtriple=aarch64 -run-pass=liveintervals -verify-machineinstrs -enable-subreg-liveness=false -o /dev/null %t/invalid-gpr.mir
# RUN: llc -mtriple=aarch64 -run-pass=liveintervals -verify-machineinstrs -enable-subreg-liveness=false -o /dev/null %t/valid.mir
# RUN: not --crash llc -mtriple=aarch64 -run-pass=liveintervals -verify-machineinstrs -enable-subreg-liveness=true -o /dev/null %t/invalid-copy.mir 2>&1 | FileCheck %s --check-prefix=COPY
# RUN: not --crash llc -mtriple=aarch64 -run-pass=liveintervals -verify-machineinstrs -enable-subreg-liveness=true -o /dev/null %t/invalid-reg-sequence.mir 2>&1 | FileCheck %s --check-prefix=SEQ
# RUN: not --crash llc -mtriple=aarch64 -run-pass=liveintervals -verify-machineinstrs -enable-subreg-liveness=true -o /dev/null %t/invalid-subreg-to-reg.mir 2>&1 | FileCheck %s --check-prefix=SUBREG
# RUN: not --crash llc -mtriple=aarch64 -run-pass=liveintervals -verify-machineinstrs -enable-subreg-liveness=true -o /dev/null %t/invalid-redefinition.mir 2>&1 | FileCheck %s --check-prefix=REDEFINITION
# RUN: not --crash llc -mtriple=aarch64 -run-pass=liveintervals -verify-machineinstrs -enable-subreg-liveness=true -o /dev/null %t/invalid-stack-load.mir 2>&1 | FileCheck %s --check-prefix=STACK

# GPR: Bad machine code: Subregister write clobbers a live-through lane
# GPR: - operand 0:   %0.sub_32:gpr64
#--- invalid-gpr.mir
---
name: clobbered_gpr_high_lane
isSSA: false
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x1, $x2, $w3, $w4

    %0:gpr64 = ADDXrr $x1, $x2
    %1:gpr32 = ADDWrr $w3, $w4
    %0.sub_32 = COPY %1
    STRXui %0, $sp, 0
    RET_ReallyLR
...

# QQQ: Bad machine code: Subregister write clobbers a live-through lane
# QQQ: - operand 0:   %0.dsub1:qqq
#--- invalid-qqq.mir
---
name: clobbered_qqq_high_lane
isSSA: false
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x0, $x1, $x2, $x3, $x4

    undef %0.qsub0:qqq = LDRQui $x1, 0
    %0.qsub1:qqq = LDRQui $x2, 0
    %0.qsub2:qqq = LDRQui $x3, 0
    %0.dsub1:qqq = LDRDui $x4, 0
    ST3Threev16b %0, $x0
    RET_ReallyLR
...

#--- valid.mir
---
name: dead_high_lane
isSSA: false
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x1, $x2, $w3, $w4

    %0:gpr64 = ADDXrr $x1, $x2
    %0.sub_32 = ADDWrr $w3, $w4
    STRWui %0.sub_32, $sp, 0
    RET_ReallyLR
...
---
name: undef_destination
isSSA: false
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x1, $x2, $w3, $w4

    %0:gpr64 = ADDXrr $x1, $x2
    undef %0.sub_32 = ADDWrr $w3, $w4
    STRXui %0, $sp, 0
    RET_ReallyLR
...
---
name: implicit_def_high_lane
isSSA: false
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $w1, $w2

    %0:gpr64 = IMPLICIT_DEF
    %0.sub_32 = ADDWrr $w1, $w2
    STRXui %0, $sp, 0
    RET_ReallyLR
...
---
name: implicit_def_zpr_high_lane
isSSA: false
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $d0

    %0:zpr = IMPLICIT_DEF
    %0.dsub = COPY $d0
    FAKE_USE %0
    RET_ReallyLR
...
---
name: implicit_def_qqq_high_lane
isSSA: false
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x0, $x1, $x2, $x3, $x4

    %0:qqq = IMPLICIT_DEF
    %0.qsub0:qqq = LDRQui $x1, 0
    %0.qsub2:qqq = LDRQui $x3, 0
    %0.dsub1:qqq = LDRDui $x4, 0
    ST3Threev16b %0, $x0
    RET_ReallyLR
...
---
name: implicit_def_qqq_component_high_lane
isSSA: false
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x0, $x1, $x3, $x4

    undef %0.qsub0:qqq = LDRQui $x1, 0
    %0.qsub1:qqq = IMPLICIT_DEF
    %0.qsub2:qqq = LDRQui $x3, 0
    %0.dsub1:qqq = LDRDui $x4, 0
    ST3Threev16b %0, $x0
    RET_ReallyLR
...

# COPY: Bad machine code: Subregister write clobbers a live-through lane
# COPY: - operand 0:   %1.sub_32:gpr64
#--- invalid-copy.mir
---
name: copied_high_lane
isSSA: false
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x1, $x2, $w3, $w4

    %0:gpr64 = ADDXrr $x1, $x2
    %1:gpr64 = COPY %0
    %1.sub_32 = ADDWrr $w3, $w4
    STRXui %1, $sp, 0
    RET_ReallyLR
...

# SEQ: Bad machine code: Subregister write clobbers a live-through lane
# SEQ: - operand 0:   %3.dsub1:qqq
# SEQ: - lanemask:    0000010000000000
#--- invalid-reg-sequence.mir
---
name: reg_sequence_high_lane
isSSA: false
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x0, $x1, $x2, $x3, $x4

    %0:fpr128 = LDRQui $x1, 0
    %1:fpr128 = LDRQui $x2, 0
    %2:fpr128 = LDRQui $x3, 0
    %3:qqq = REG_SEQUENCE %0, %subreg.qsub0, %1, %subreg.qsub1, %2, %subreg.qsub2
    %3.dsub1 = LDRDui $x4, 0
    ST3Threev16b %3, $x0
    RET_ReallyLR
...

# SUBREG: Bad machine code: Subregister write clobbers a live-through lane
# SUBREG: - operand 0:   %1.sub_32:gpr64
#--- invalid-subreg-to-reg.mir
---
name: subreg_to_reg_high_lane
isSSA: false
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $w1, $w2, $w3, $w4

    %0:gpr32 = ADDWrr $w1, $w2
    %1:gpr64 = SUBREG_TO_REG %0, %subreg.sub_32
    %1.sub_32 = ADDWrr $w3, $w4
    STRXui %1, $sp, 0
    RET_ReallyLR
...


# A partial write may clobber live-through lanes supplied by IMPLICIT_DEF, but
# not by a real def.
# REDEFINITION: Bad machine code: Subregister write clobbers a live-through lane
# REDEFINITION: - instruction: {{.*}}%0.sub_32:gpr64 = ADDWrr $w3, $w4
# REDEFINITION: - operand 0:   %0.sub_32:gpr64
#--- invalid-redefinition.mir
---
name: redefined_sub_32
isSSA: false
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $w1, $w2, $w3, $w4

    %0:gpr64 = IMPLICIT_DEF
    %0.sub_32 = ADDWrr $w1, $w2
    %0:gpr64 = ADDXrr $x1, $x2
    %0.sub_32 = ADDWrr $w3, $w4
    STRXui %0, $sp, 0
    RET_ReallyLR
...

# Loads from ordinary stack objects must still be checked.
# STACK: Bad machine code: Subregister write clobbers a live-through lane
# STACK: - operand 0:   %0.sub_32:gpr64
#--- invalid-stack-load.mir
---
name: stack_load_high_lane
isSSA: false
tracksRegLiveness: true
stack:
  - { id: 0, size: 8, alignment: 8 }
body: |
  bb.0:
    %0:gpr64 = LDRXui %stack.0, 0 :: (load (s64) from %stack.0)
    %0.sub_32 = MOVi32imm 0
    STRXui %0, %stack.0, 0 :: (store (s64) into %stack.0)
    RET_ReallyLR
...
