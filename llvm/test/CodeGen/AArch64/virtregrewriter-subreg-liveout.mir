# RUN: llc -mtriple=aarch64 -enable-subreg-liveness -verify-machineinstrs \
# RUN:   -passes='greedy,virt-reg-rewriter' %s -o - | FileCheck %s

# The X definition is used in full locally, but only its low 32 bits are live
# out. The successor can describe this with a lane mask on its X live-in.
---
name: x_def_sub32_liveout
isSSA: false
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: x_def_sub32_liveout
  ; CHECK: renamable $x[[REG:[0-9]+]] = MOVi64imm 1
  ; CHECK-NEXT: FAKE_USE renamable $x[[REG]]
  ; CHECK-NEXT: B %bb.1
  ; CHECK: bb.1:
  ; CHECK-NEXT: liveins: $x[[REG]]:0x0000000000000040
  ; CHECK: FAKE_USE killed renamable $w[[REG]]
  bb.0:
    successors: %bb.1

    %0:gpr64common = MOVi64imm 1
    FAKE_USE %0
    B %bb.1

  bb.1:
    FAKE_USE %0.sub_32
    RET_ReallyLR
...

# Unlike ordinary live-out lanes above, the undefined high lane on the bb.1
# edge needs an extra def because it is live into the merge block. This reaches
# getCoveringSubRegIndexes and represents the lane with the artificial W_HI.
---
name: undef_sub32_high_phi_liveout
isSSA: false
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: undef_sub32_high_phi_liveout
  ; CHECK: renamable $w[[PHI:[0-9]+]] = MOVi32imm 1, implicit-def $w[[PHI]]_hi, implicit-def renamable $x[[PHI]]
  ; CHECK: bb.3:
  ; CHECK-NEXT: liveins: $x[[PHI]]:0x00000000000000C0
  ; CHECK: FAKE_USE killed renamable $x[[PHI]]
  bb.0:
    successors: %bb.1, %bb.2

    CBNZW $wzr, %bb.2
    B %bb.1

  bb.1:
    successors: %bb.3

    undef %0.sub_32:gpr64common = MOVi32imm 1
    B %bb.3

  bb.2:
    successors: %bb.3

    %0:gpr64common = MOVi64imm 2
    B %bb.3

  bb.3:
    FAKE_USE %0
    RET_ReallyLR
...
